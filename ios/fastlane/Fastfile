default_platform(:ios)

ROOT = File.expand_path("..", __dir__)
PROJECT = File.join(ROOT, "ShelfIOS.xcodeproj")
SCHEME = "ShelfIOS"
APP_IDENTIFIER = "com.madebysan.ShelfIOS"
APP_STORE_APPLE_ID = "6771934035"
APP_NAME = "Shelf: Audiobook Player"
SKU = "shelf-ios"
PROFILE_NAME = "#{APP_IDENTIFIER} AppStore"
PROFILE_DIR = File.join(ROOT, "build/profiles")
PROFILE_FILENAME = "ShelfIOS_AppStore.mobileprovision"
RELEASE_VERSION = "1.0"
RELEASE_BUILD = "1"
ASC_TEAM_ID = "121817262"
DEV_PORTAL_TEAM_ID = "QAMM2A6WRQ"
COPYRIGHT_TEXT = "2026 Santiago Alonso"
REVIEW_NOTES = "Shelf is a Google Drive client for playing the user's own audiobook and media files. Google Sign-In is required so users can directly access their own Drive content. Under App Review Guideline 4.8, another login service is not required because Shelf is a client for a specific third-party service and users are required to sign in to that third-party account directly to access their content. Shelf does not include ads, tracking, analytics, in-app purchases, or bundled media content."
API_KEY_JSON_PATH = ENV.fetch(
  "APP_STORE_CONNECT_API_KEY_PATH",
  File.expand_path("~/private_keys/api_key.json")
)

def asc_api_key
  UI.user_error!("App Store Connect API key JSON not found at #{API_KEY_JSON_PATH}") unless File.exist?(API_KEY_JSON_PATH)

  api_key = JSON.parse(File.read(API_KEY_JSON_PATH), symbolize_names: true)
  key_filepath = File.expand_path(api_key.fetch(:key_filepath), File.dirname(API_KEY_JSON_PATH))
  app_store_connect_api_key(
    key_id: api_key.fetch(:key_id),
    issuer_id: api_key.fetch(:issuer_id),
    key_filepath: key_filepath,
    duration: api_key.fetch(:duration, 1200),
    in_house: api_key.fetch(:in_house, false)
  )
end

def assert_command!(command)
  UI.user_error!("Command failed: #{command}") unless system(command)
end

def find_free_us_price_point!(app_id)
  params = Spaceship::ConnectAPI.tunes_request_client.build_params(
    filter: {
      territory: "USA"
    },
    fields: {
      appPricePoints: "customerPrice,proceeds,territory"
    },
    limit: 200
  )
  response = Spaceship::ConnectAPI.tunes_request_client.get("v1/apps/#{app_id}/appPricePoints", params)
  price_points = response.all_pages.flat_map { |page| page.body.fetch("data", []) }
  free_price = price_points.find do |price_point|
    attributes = price_point.fetch("attributes", {})
    attributes["customerPrice"].to_s == "0.0" || attributes["customerPrice"].to_s == "0"
  end

  UI.user_error!("Could not find a free USA app price point for #{APP_IDENTIFIER}.") if free_price.nil?

  free_price.fetch("id")
end

def set_free_app_store_pricing!(app)
  price_point_id = find_free_us_price_point!(app.id)
  manual_price_id = "${free-price-usa}"
  body = {
    data: {
      type: "appPriceSchedules",
      relationships: {
        app: {
          data: {
            type: "apps",
            id: app.id
          }
        },
        baseTerritory: {
          data: {
            type: "territories",
            id: "USA"
          }
        },
        manualPrices: {
          data: [
            {
              type: "appPrices",
              id: manual_price_id
            }
          ]
        }
      }
    },
    included: [
      {
        type: "appPrices",
        id: manual_price_id,
        attributes: {
          startDate: nil
        },
        relationships: {
          appPricePoint: {
            data: {
              type: "appPricePoints",
              id: price_point_id
            }
          }
        }
      }
    ]
  }

  Spaceship::ConnectAPI.tunes_request_client.post("v1/appPriceSchedules", body)
end

def app_store_territory_ids
  Spaceship::ConnectAPI::Territory.all.map(&:id).sort
end

def fetch_app_store_availability(app)
  params = {
    "include" => "territoryAvailabilities",
    "limit[territoryAvailabilities]" => 50
  }
  response = Spaceship::ConnectAPI.tunes_request_client.get("v2/appAvailabilities/#{app.id}", params)
  body = response.body
  pages = response.respond_to?(:all_pages) ? response.all_pages : [response]
  included = pages.flat_map { |page| page.body.fetch("included", []) }
  body["included"] = included unless included.empty?
  body
rescue => error
  message = error.to_s
  return nil if message.include?("404") || message.include?("NOT_FOUND") || message.include?("not found") || message.include?("does not exist")

  raise
end

def fetch_territory_availabilities(app)
  client = Spaceship::ConnectAPI.tunes_request_client
  territory_availabilities = []
  params = { "limit" => 50 }

  loop do
    response = client.get("v2/appAvailabilities/#{app.id}/territoryAvailabilities", params)
    territory_availabilities.concat(response.body.fetch("data", []))

    next_link = response.body.dig("links", "next")
    break if next_link.to_s.empty?

    query = URI.parse(next_link).query
    cursor = URI.decode_www_form(query).to_h.fetch("cursor")
    params = { "limit" => 50, "cursor" => cursor }
  end

  territory_availabilities
end

def territory_id_from_availability(territory_availability)
  encoded = territory_availability.fetch("id")
  padded = encoded + ("=" * ((4 - encoded.length % 4) % 4))
  JSON.parse(Base64.urlsafe_decode64(padded))["t"]
rescue
  nil
end

def app_store_availability_summary(app)
  availability = fetch_app_store_availability(app)
  return "App Store availability is not configured." if availability.nil?

  territory_availabilities = fetch_territory_availabilities(app)
  total = availability.dig("data", "relationships", "territoryAvailabilities", "meta", "paging", "total") || territory_availabilities.count
  available = territory_availabilities.select do |territory|
    territory.fetch("attributes", {})["available"] == true
  end
  available_country_ids = available.filter_map { |territory| territory_id_from_availability(territory) }.sort
  blocked_available = available.select do |territory|
    attributes = territory.fetch("attributes", {})
    Array(attributes["contentStatuses"]).any? { |status| status.to_s.include?("NOT_PROVIDED") }
  end

  if blocked_available.empty?
    if available_country_ids == ["USA"]
      "App Store availability configured for USA only."
    elsif available.count == total
      "App Store availability configured for #{total} territories."
    else
      "App Store availability configured for #{available.count} of #{total} territories."
    end
  else
    samples = blocked_available.first(5).map do |territory|
      attributes = territory.fetch("attributes", {})
      country = territory_id_from_availability(territory) || "unknown"
      statuses = Array(attributes["contentStatuses"]).join(", ")
      "#{country}: #{statuses.empty? ? 'blocked' : statuses}"
    end
    "App Store availability configured for #{available.count} of #{total} territories, with #{blocked_available.count} available territories requiring action. Examples: #{samples.join('; ')}"
  end
end

def update_app_store_territory_availability!(app, available_country_ids:)
  territory_availabilities = fetch_territory_availabilities(app)
  UI.user_error!("No territory availability records returned for #{APP_IDENTIFIER}.") if territory_availabilities.empty?

  wanted = available_country_ids.to_set
  updated_count = 0
  territory_availabilities.each_with_index do |territory_availability, index|
    country = territory_id_from_availability(territory_availability)
    next if country.nil?

    should_be_available = wanted.include?(country)
    attributes = territory_availability.fetch("attributes", {})
    next if attributes["available"] == should_be_available

    id = territory_availability.fetch("id")
    Spaceship::ConnectAPI.tunes_request_client.patch(
      "v1/territoryAvailabilities/#{id}",
      {
        data: {
          type: "territoryAvailabilities",
          id: id,
          attributes: {
            available: should_be_available
          }
        }
      }
    )
    updated_count += 1
    UI.message("Updated #{updated_count} territories...") if (updated_count % 25).zero? || index == territory_availabilities.length - 1
  end

  UI.success("Updated App Store availability for #{wanted.to_a.sort.join(', ')}; changed #{updated_count} territories.")
end

def set_available_in_new_territories!(app, available:)
  Spaceship::ConnectAPI.tunes_request_client.patch(
    "v2/appAvailabilities/#{app.id}",
    {
      data: {
        type: "appAvailabilities",
        id: app.id,
        attributes: {
          availableInNewTerritories: available
        }
      }
    }
  )
rescue => error
  UI.important("Could not update availableInNewTerritories: #{error.message}")
end

def ensure_us_only_app_store_availability!(app)
  ensure_app_store_availability!(app)
  set_available_in_new_territories!(app, available: false)
  update_app_store_territory_availability!(app, available_country_ids: ["USA"])
  UI.message(app_store_availability_summary(app))
end

def ensure_all_app_store_territories_available!(app)
  ensure_app_store_availability!(app)
  set_available_in_new_territories!(app, available: true)
  update_app_store_territory_availability!(app, available_country_ids: app_store_territory_ids)
  UI.message(app_store_availability_summary(app))
end

def ensure_app_store_availability!(app)
  existing = fetch_app_store_availability(app)
  unless existing.nil?
    return
  end

  territory_ids = app_store_territory_ids
  UI.user_error!("No App Store territories returned by App Store Connect.") if territory_ids.empty?

  body = {
    data: {
      type: "appAvailabilities",
      attributes: {
        availableInNewTerritories: true
      },
      relationships: {
        app: {
          data: {
            type: "apps",
            id: app.id
          }
        },
        territoryAvailabilities: {
          data: territory_ids.map do |territory_id|
            {
              type: "territoryAvailabilities",
              id: "${#{territory_id}}"
            }
          end
        }
      }
    },
    included: territory_ids.map do |territory_id|
      {
        type: "territoryAvailabilities",
        id: "${#{territory_id}}",
        attributes: {
          available: true
        },
        relationships: {
          territory: {
            data: {
              type: "territories",
              id: territory_id
            }
          }
        }
      }
    end
  }

  Spaceship::ConnectAPI.tunes_request_client.post("v2/appAvailabilities", body)
  UI.success("Set App Store availability for #{territory_ids.count} territories.")
end

platform :ios do
  before_all do
    ENV["FASTLANE_HIDE_CHANGELOG"] = "1"
    ENV["FASTLANE_SKIP_UPDATE_CHECK"] = "1"
  end

  desc "Local preflight: build settings, privacy manifest, icon alpha, support URLs"
  lane :preflight do
    issues = []

    pbxproj = File.join(ROOT, "ShelfIOS.xcodeproj/project.pbxproj")
    privacy_manifest = File.join(ROOT, "ShelfIOS/PrivacyInfo.xcprivacy")
    entitlements = File.join(ROOT, "ShelfIOS/ShelfIOS.entitlements")
    info_plist = File.join(ROOT, "ShelfIOS/Info.plist")

    issues << "Missing PrivacyInfo.xcprivacy" unless File.exist?(privacy_manifest)
    issues << "Bundle ID is not #{APP_IDENTIFIER}" unless File.read(pbxproj).include?("PRODUCT_BUNDLE_IDENTIFIER = #{APP_IDENTIFIER};")
    issues << "Version/build mismatch" unless File.read(info_plist).include?("<string>#{RELEASE_VERSION}</string>") && File.read(info_plist).include?("<string>#{RELEASE_BUILD}</string>")
    issues << "aps-environment is not production" unless File.read(entitlements).include?("<string>production</string>")

    Dir.glob(File.join(ROOT, "ShelfIOS/Assets.xcassets/AppIcon.appiconset/*.png")).each do |icon|
      out = `/usr/bin/sips -g hasAlpha #{Shellwords.escape(icon)} 2>/dev/null`
      issues << "App icon has alpha: #{icon.sub(ROOT + "/", "")}" if out.include?("hasAlpha: yes")
    end

    ["https://santiagoalonso.com/shelf/support", "https://santiagoalonso.com/shelf/privacy"].each do |url|
      status = `curl -L -s -o /dev/null -w "%{http_code}" #{Shellwords.escape(url)}`
      issues << "URL did not return 200: #{url}" unless status == "200"
    end

    if issues.empty?
      UI.success("Shelf preflight passed.")
    else
      UI.user_error!("Shelf preflight failed:\n  - #{issues.join("\n  - ")}")
    end
  end

  desc "Create or verify the App Store Connect app record"
  lane :create_app_store_record do
    produce(
      app_identifier: APP_IDENTIFIER,
      app_name: APP_NAME,
      username: "test.snt.aln@gmail.com",
      sku: SKU,
      team_id: DEV_PORTAL_TEAM_ID,
      itc_team_id: ASC_TEAM_ID,
      platform: "ios",
      app_version: RELEASE_VERSION,
      enable_services: {
        icloud: "cloudkit",
        push_notification: "on"
      }
    )
  end

  desc "Read-only App Store release status check"
  lane :release_status do
    asc_api_key

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("No App Store Connect record found for #{APP_IDENTIFIER}") unless app

    version = app.get_edit_app_store_version(platform: "IOS")
    if version
      UI.message("App Store version: #{version.version_string} (#{version.app_version_state || version.app_store_state})")
    else
      UI.important("No editable App Store version found.")
    end

    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id,
      version: RELEASE_VERSION,
      build_number: RELEASE_BUILD,
      platform: "IOS"
    )
    build = builds.first

    if build
      UI.success("Build found: #{RELEASE_VERSION} (#{build.version}) processing=#{build.processing_state} internal_testing=#{build.ready_for_internal_testing?}")
    else
      UI.important("No build found for #{RELEASE_VERSION} (#{RELEASE_BUILD}).")
    end

    UI.message(app_store_availability_summary(app))
  end

  desc "Set App Store pricing to free with USA as the base territory"
  lane :set_free_pricing do
    asc_api_key

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("No App Store Connect app found for #{APP_IDENTIFIER}.") if app.nil?

    set_free_app_store_pricing!(app)
    UI.success("Set #{APP_IDENTIFIER} App Store pricing to free.")
  end

  desc "Set App Store availability for all current and future territories"
  lane :set_app_store_availability do
    asc_api_key

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("No App Store Connect app found for #{APP_IDENTIFIER}.") if app.nil?

    ensure_all_app_store_territories_available!(app)
  end

  desc "Set App Store availability to United States only"
  lane :set_app_store_us_only do
    asc_api_key

    app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
    UI.user_error!("No App Store Connect app found for #{APP_IDENTIFIER}.") if app.nil?

    ensure_us_only_app_store_availability!(app)
  end

  desc "Build a simulator sanity check"
  lane :build_simulator do
    assert_command!("cd #{ROOT.shellescape} && xcodebuild -project ShelfIOS.xcodeproj -scheme ShelfIOS -configuration Debug -destination 'generic/platform=iOS Simulator' -derivedDataPath build/DerivedData build")
  end

  desc "Create or download the App Store provisioning profile"
  lane :provision_app_store do
    sigh(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      team_id: DEV_PORTAL_TEAM_ID,
      provisioning_name: PROFILE_NAME,
      output_path: PROFILE_DIR,
      filename: PROFILE_FILENAME,
      platform: "ios"
    )
  end

  desc "Archive an App Store candidate"
  lane :build_app_store do
    provision_app_store

    build_app(
      project: PROJECT,
      scheme: SCHEME,
      configuration: "Release",
      export_method: "app-store",
      output_directory: File.join(ROOT, "build/app-store"),
      output_name: "ShelfIOS.ipa",
      clean: true,
      xcargs: "-allowProvisioningUpdates",
      skip_profile_detection: true,
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: DEV_PORTAL_TEAM_ID,
        provisioningProfiles: {
          APP_IDENTIFIER => PROFILE_NAME
        }
      }
    )
  end

  desc "Upload an already-built App Store candidate to TestFlight"
  lane :upload_testflight do
    pilot(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      ipa: File.join(ROOT, "build/app-store/ShelfIOS.ipa"),
      skip_waiting_for_build_processing: false
    )
  end

  desc "Upload App Store metadata without binary or screenshots"
  lane :upload_metadata do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      username: "test.snt.aln@gmail.com",
      team_id: ASC_TEAM_ID,
      dev_portal_team_id: DEV_PORTAL_TEAM_ID,
      app_version: RELEASE_VERSION,
      metadata_path: File.join(ROOT, "fastlane/metadata"),
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      app_rating_config_path: File.join(ROOT, "fastlane/age_rating_config.json"),
      primary_category: "BOOKS",
      copyright: COPYRIGHT_TEXT,
      app_review_information: {
        notes: REVIEW_NOTES
      },
      force: true
    )
  end

  desc "Upload App Privacy answers from fastlane/app_privacy_details.json"
  lane :upload_app_privacy do
    upload_app_privacy_details_to_app_store(
      username: "test.snt.aln@gmail.com",
      team_id: ASC_TEAM_ID,
      app_identifier: APP_IDENTIFIER,
      json_path: File.join(ROOT, "fastlane/app_privacy_details.json")
    )
  end

  desc "Upload App Store screenshots without submitting for review"
  lane :upload_screenshots do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      username: "test.snt.aln@gmail.com",
      team_id: ASC_TEAM_ID,
      dev_portal_team_id: DEV_PORTAL_TEAM_ID,
      app_version: RELEASE_VERSION,
      metadata_path: File.join(ROOT, "fastlane/metadata"),
      screenshots_path: File.join(ROOT, "fastlane/screenshots"),
      skip_binary_upload: true,
      skip_metadata: true,
      skip_screenshots: false,
      overwrite_screenshots: true,
      submit_for_review: false,
      run_precheck_before_submit: false,
      force: true
    )
  end

  desc "Submit the current App Store candidate for review"
  lane :submit_app_store_review do
    deliver(
      api_key: asc_api_key,
      app_identifier: APP_IDENTIFIER,
      username: "test.snt.aln@gmail.com",
      team_id: ASC_TEAM_ID,
      dev_portal_team_id: DEV_PORTAL_TEAM_ID,
      app_version: RELEASE_VERSION,
      build_number: RELEASE_BUILD,
      metadata_path: File.join(ROOT, "fastlane/metadata"),
      screenshots_path: File.join(ROOT, "fastlane/screenshots"),
      skip_binary_upload: true,
      skip_metadata: false,
      skip_screenshots: false,
      app_rating_config_path: File.join(ROOT, "fastlane/age_rating_config.json"),
      primary_category: "BOOKS",
      copyright: COPYRIGHT_TEXT,
      submit_for_review: true,
      automatic_release: false,
      precheck_include_in_app_purchases: false,
      force: true,
      app_review_information: {
        first_name: "Santiago",
        last_name: "Alonso",
        phone_number: ENV.fetch("APP_REVIEW_PHONE"),
        email_address: "test.snt.aln@gmail.com",
        notes: REVIEW_NOTES
      },
      submission_information: {
        add_id_info_serves_ads: false,
        add_id_info_tracks_action: false,
        add_id_info_tracks_install: false,
        add_id_info_uses_idfa: false,
        content_rights_contains_third_party_content: false,
        export_compliance_uses_encryption: false
      }
    )
  end
end
